# ===== LLM (כל ספק תואם OpenAI) =====
LLM_API_KEY=your-key-here
# Gemini (ברירת מחדל):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash
# OpenAI: להשאיר LLM_BASE_URL ריק ו-LLM_MODEL=gpt-4o-mini

# ===== Playwright =====
# false = הדפדפן נפתח מול העיניים (מומלץ לפיתוח ולהדגמה)
HEADLESS=false
# השהיה בין פעולות (מילישניות) – כדי לראות מה קורה
SLOW_MO=300

# ===== דריסת סלקטורים (אופציונלי) =====
# אם מבנה האתר השתנה – להריץ:  uv run debug_site.py --inspect
# ולהזין כאן את הסלקטור הנכון:
# SEARCH_INPUT_SELECTOR=
# SUGGESTION_SELECTOR=

# לוגים מפורטים של ה-Server (INFO / WARNING)
LOG_LEVEL=WARNING
